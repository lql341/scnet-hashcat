#!/usr/bin/env bash
# Compatibility entrypoint; native Windows callers can run hc.py directly.
set -eu
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v cygpath >/dev/null 2>&1; then HERE="$(cygpath -w "$HERE")"; fi
export MSYS2_ARG_CONV_EXCL='*'
exec "${SCNET_HASHCAT_PYTHON:-python3}" "$HERE/hc.py" "$@"
